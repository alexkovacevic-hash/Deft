# Database ---------------------------------------------------------------
# The connection the app uses at runtime. On a serverless host this must be
# your provider's POOLED string: a direct endpoint will exhaust its connection
# limit, and Supabase's is IPv6-only, which serverless platforms can't reach.
DATABASE_URL="postgresql://user:password@localhost:5432/deft_designer"

# The connection migrations use, needed only when DATABASE_URL is pooled.
# Migrations take an advisory lock that transaction-mode poolers (pgbouncer,
# Supabase port 6543) don't support, so point this at the DIRECT string.
# Neon on Vercel provides DATABASE_URL_UNPOOLED, which is picked up too.
# DIRECT_URL=""

# NextAuth ---------------------------------------------------------------
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.example.com"

# Stripe (invoicing + payments) ------------------------------------------
# Leave blank to run without online payments; portal checkout then returns a
# clear "not configured" message instead of failing.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public base URL used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL="https://your-app.example.com"
