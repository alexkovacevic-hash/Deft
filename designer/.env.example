# Database ---------------------------------------------------------------
# PostgreSQL connection string.
#
# If your host offers BOTH a pooled and a direct URL (Neon, Supabase), use the
# DIRECT one here. Migrations take an advisory lock and cannot run through a
# transaction-mode pooler such as pgbouncer (Supabase port 6543).
DATABASE_URL="postgresql://user:password@localhost:5432/deft_designer"

# NextAuth ---------------------------------------------------------------
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.example.com"

# Stripe (invoicing + payments) ------------------------------------------
# Leave blank to run without online payments; portal checkout then returns a
# clear "not configured" message instead of failing.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public base URL used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL="https://your-app.example.com"
